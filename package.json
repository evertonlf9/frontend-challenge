{
  "name": "meu-projeto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && vite build --mode mock",
    "typecheck": "tsc -b --pretty",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "test:a11y": "playwright test accessibility",
    "test:all": "npm run test:e2e && npm run test:visual",
    "verify": "npm run check && npm run test:all && npm run audit:lighthouse && npm run evidence:collect",
    "evidence:collect": "node scripts/collect-evidence.mjs",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:report": "playwright show-report playwright-report/e2e",
    "audit:lighthouse": "npm run build:mock && node scripts/lighthouse.mjs",
    "dev:api": "vite --mode api",
    "build:api": "tsc -b && vite build --mode api",
    "test:report:visual": "playwright show-report playwright-report/visual",
    "test:default": "node scripts/smoke-default.mjs",
    "test:build": "node scripts/smoke-build.mjs",
    "assets:optimize": "node scripts/optimize-artwork.mjs"
  },
  "engines": {
    "node": ">=24.8.0",
    "npm": ">=11"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mswjs/socket.io-binding": "^0.2.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.0",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0",
    "msw": "^2.15.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
